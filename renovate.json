{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Docker image tags declared in OpenDock dotenv files",
      "managerFilePatterns": [
        "/(^|/)\\.env\\.default$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?<variable>[A-Z0-9_]+)=(?<currentValue>[^\\s#]+)"
      ],
      "versioningTemplate": "docker"
    }
  ]
}
