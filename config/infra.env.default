# OpenDock managed settings. Local values are stored in the matching .env file.
MARIADB_ROOT_PASSWORD=change-root-password
POSTGRES_ADMIN_USER=opendock
POSTGRES_ADMIN_PASSWORD=change-postgres-admin-password

# renovate: datasource=docker depName=mariadb
MARIADB_VERSION=11.8-noble
# renovate: datasource=docker depName=postgres
POSTGRES_VERSION=18-bookworm
# renovate: datasource=docker depName=redis
REDIS_VERSION=8-alpine
