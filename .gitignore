.DS_Store
/archive/

common.env
.sync.env
.sync.env.toml
*.swp
__pycache__/
/config/**/*.env
/config/extensions/
/config/.service-default-migration-v1
/config/.infra-default-migration-v1
/config/.gateway-default-migration-v1
services/*/.env
services/bundles/*/.env
# Package code, registry, and state installed by OpenDock.
/services/extensions/
/infra/.env
/gateway/.env

services/*/data/
services/*/backups/
services/bundles/*/data/
services/bundles/*/backups/
backups/common-env/
backups/config/

# User-provided Supabase Edge Function secrets. Keep the example in Git.
services/supabase/functions.env

# Per-host route configuration and static web roots.
/domains.conf
/gateway/caddy/conf.d/zz-opendock-routes.caddy
/gateway/caddy/conf.d/yy-opendock-service-handlers.caddy
/static-sites/*/**
!/static-sites/*/README.md
