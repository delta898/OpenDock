def parser():
    p = argparse.ArgumentParser(
        prog="./opendock", description="Configure, run, and publish OpenDock services.",
        epilog="Start here: ./opendock setup, then ./opendock launch blog.example.com. "
               "Use './opendock <command> --help' for command options.",
    )
    sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("help", help="Show this guide")
    l = sub.add_parser("list", help="List services and groups")
    l.add_argument("kind", nargs="?", choices=("services", "groups"))
    info = sub.add_parser("info", help="Show configured image tags and running containers")
    info.add_argument("target", nargs="?", help="One service, group, infra, or gateway")
    for command in sorted(LIFECYCLE):
        item = sub.add_parser(command, help=f"Docker Compose {command} for a target")
        if command in ("ps", "config"):
            item.add_argument("target", nargs="?", default="all")
        else:
            item.add_argument("target")
    for command in ("setup", "secrets", "check-config", "publish", "launch"):
        item = sub.add_parser(command)
        item.add_argument("target", nargs="?", default="all")
    logs = sub.add_parser("logs", help="Follow logs for one service")
    logs.add_argument("target")
    service_cmd = sub.add_parser("service", help="Run a service-specific command")
    service_cmd.add_argument("service")
    service_cmd.add_argument("name", nargs="?", default="")
    service_cmd.add_argument("args", nargs=argparse.REMAINDER)
    route_cmd = sub.add_parser("route", help="Manage hostname routes")
    route_sub = route_cmd.add_subparsers(dest="route_command", required=True)
    show = route_sub.add_parser("show")
    show.add_argument("hostname", nargs="?")
    add = route_sub.add_parser(
        "add", description="Map a full hostname to an installed Docker service or a static site.",
        epilog=("Examples:\n"
                "  ./opendock route add blog.example.org wordpress\n"
                "  ./opendock route add docs.example.org static\n\n"
                "Then run './opendock launch <hostname>' to apply the route. "
                "Static files go in static-sites/<hostname>/."),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    add.add_argument("hostname", help="Full public hostname, e.g. docs.example.org")
    add.add_argument("service", metavar="service|static",
                     help="Installed service name (e.g. wordpress) or static")
    remove = route_sub.add_parser("remove")
    remove.add_argument("hostname")
    sync_cmd = sub.add_parser("sync", help="Deploy code to a named remote")
    sync_cmd.add_argument("name")
    sync_cmd.add_argument("--dry-run", action="store_true")
    old_sync = sub.add_parser("sync-dry-run", help="Compatibility alias for sync --dry-run")
    old_sync.add_argument("name")
    return p


def main(argv=None):
    p = parser()
    arguments = sys.argv[1:] if argv is None else argv
    if arguments in ([], ["--help"], ["-h"], ["help"]):
        print_guide()
        return 0
    args = p.parse_args(argv)
    try:
        command = args.command
        if command == "help":
            print_guide()
        elif command == "list":
            list_targets(args.kind)
        elif command == "info":
            show_info(args.target)
        elif command in LIFECYCLE:
            if not args.target:
                p.error(f"{command} requires a target")
            lifecycle(command, args.target)
        elif command == "logs":
            if args.target in ("all", "services") or args.target in groups():
                raise CLIError("logs requires one service, infra, or gateway target")
            target = targets(args.target)
            compose(target[0], "logs", "-f")
        elif command == "setup":
            script("opendock-config.py", args.target)
        elif command == "secrets":
            script("opendock-secrets.py", args.target)
        elif command == "check-config":
            try:
                check_config(args.target)
            except CLIError as exc:
                raise CLIError("Configuration is not ready. No services were changed.") from exc
        elif command == "publish":
            publish(args.target)
        elif command == "launch":
            launch(args.target)
        elif command == "route":
            route(args.route_command, getattr(args, "hostname", None), getattr(args, "service", None))
        elif command == "service":
            result = subprocess.run(
                [sys.executable, ROOT / "scripts/opendock-service.py",
                 args.service, args.name, *args.args],
                cwd=ROOT,
            )
            return result.returncode
        elif command == "sync":
            sync(args.name, args.dry_run)
        elif command == "sync-dry-run":
            sync(args.name, True)
    except (CLIError, OSError, ValueError) as exc:
        print(f"OpenDock: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
