#!/usr/bin/env python3
"""OpenDock's repository-local command line interface."""

import argparse
import fnmatch
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
import textwrap
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # Python < 3.11 can use the rest of the CLI, but not TOML sync config.
    tomllib = None


ROOT = Path(__file__).resolve().parent
SERVICES = ROOT / "services"
GROUPS = SERVICES / "groups.conf"
SYNC_CONFIG = ROOT / ".sync.env.toml"
CHECKED = {"up", "restart", "start", "build", "config"}
LIFECYCLE = CHECKED | {"down", "stop", "ps", "pull"}
EXCLUDES = (
    ".git/", ".sync.env", ".sync.env.toml", "common.env", "domains.conf",
    "gateway/caddy/conf.d/zz-opendock-routes.caddy",
    "cloudflare.env", "*.env", "services/supabase/functions.env",
    "services/*/data/", "**/data/", "services/*/backups/",
    "backups/", ".DS_Store",
)
REMOTE_SYNC_PRUNE = r'''
import json, os, sys

mode, root = sys.argv[1:]
root = os.path.realpath(root)
data = json.loads(sys.stdin.buffer.read().decode("utf-8"))
if not isinstance(data, list) or not all(isinstance(item, str) for item in data):
    raise ValueError("invalid OpenDock sync file list")
current = {os.fsdecode(bytes.fromhex(item)) for item in data}
protected_files = {
    ".sync.env", ".sync.env.toml", "common.env", "cloudflare.env", "domains.conf",
    "gateway/caddy/conf.d/zz-opendock-routes.caddy",
    "services/supabase/functions.env",
}
# Keep these destination protections aligned with EXCLUDES and .gitignore.
protected_dirs = {".git", "data", "backups"}

def protected(rel):
    parts = rel.split(os.sep)
    if (rel in protected_files or any(part in protected_dirs for part in parts)
            or any(part.endswith(".env") for part in parts)):
        return True
    # Preserve static web content, but keep its tracked repository README in sync.
    if rel.startswith("static-sites/") and rel != "static-sites/README.md":
        return True
    return False

def prune(directory, relative=""):
    removed = 0
    for entry in sorted(os.scandir(directory), key=lambda item: item.name):
        rel = os.path.join(relative, entry.name) if relative else entry.name
        if protected(rel):
            continue
        if entry.is_dir(follow_symlinks=False):
            removed += prune(entry.path, rel)
            if mode == "apply":
                try:
                    os.rmdir(entry.path)
                except OSError:
                    pass
            continue
        normalized = rel.replace(os.sep, "/")
        if normalized in current or entry.name == ".DS_Store":
            continue
        if mode == "preview":
            print("Would remove destination-only repository file: " + normalized)
        elif mode == "apply":
            os.unlink(entry.path)
            print("Removed destination-only repository file: " + normalized)
        else:
            raise ValueError("unknown OpenDock sync mode")
        removed += 1
    return removed

removed = prune(root)
print("Destination-only repository files removed: {}".format(removed))
'''


class CLIError(Exception):
    pass


def run(*args, env=None, capture=False, quiet=False, input_data=None):
    try:
        result = subprocess.run(
            [str(arg) for arg in args], cwd=ROOT, env=env,
            input=input_data, text=not isinstance(input_data, bytes),
            stdout=subprocess.PIPE if capture else (subprocess.DEVNULL if quiet else None),
            stderr=subprocess.DEVNULL if quiet else None, check=False,
        )
    except FileNotFoundError as exc:
        raise CLIError(f"Required command not found: {exc.filename}") from exc
    if result.returncode:
        raise CLIError(f"Command failed ({result.returncode}): {args[0]}")
    return result.stdout.strip() if capture else None


def sync_file_list(raw_paths):
    """Return safe repository paths selected for deployment."""
    selected = []
    for raw_path in raw_paths.split(b"\0"):
        if not raw_path:
            continue
        rel = os.fsdecode(raw_path)
        parts = rel.split("/")
        excluded = rel.startswith("static-sites/") and rel != "static-sites/README.md"
        for pattern in EXCLUDES:
            if excluded:
                break
            if pattern.endswith("/"):
                directory = pattern[:-1]
                if directory.startswith("**/"):
                    directory = directory[3:]
                    matches = directory in parts[:-1]
                else:
                    matches = any(
                        fnmatch.fnmatchcase("/".join(parts[:index]), directory)
                        for index in range(1, len(parts))
                    )
                if matches:
                    excluded = True
                    break
            elif "*" in pattern:
                if any(fnmatch.fnmatchcase(part, pattern) for part in parts):
                    excluded = True
                    break
            elif rel == pattern or pattern in parts:
                excluded = True
                break
        if excluded:
            continue
        full_path = ROOT / rel
        try:
            full_path.lstat()
        except FileNotFoundError:
            # A tracked file deleted from the worktree is not part of this deployment.
            continue
        if not full_path.is_symlink() and not full_path.is_file():
            continue
        selected.append(raw_path)
    if not selected:
        raise CLIError("No repository files found to sync after applying safety exclusions.")
    file_list = b"\0".join(selected) + b"\0"
    remote_list = json.dumps([path.hex() for path in selected], separators=(",", ":")).encode("utf-8")
    return file_list, remote_list


def remote_sync_prune(remote, path, port, mode, file_list):
    command = "python3 -c {} {} {}".format(
        shlex.quote(REMOTE_SYNC_PRUNE), shlex.quote(mode), shlex.quote(path)
    )
    args = ["ssh"]
    if port:
        args += ["-p", str(port)]
    args += [remote, command]
    try:
        result = subprocess.run(
            args, cwd=ROOT, input=file_list, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, check=False,
        )
    except FileNotFoundError as exc:
        raise CLIError("Required command not found: ssh") from exc
    if result.returncode:
        detail = result.stderr.decode("utf-8", errors="replace").strip()
        raise CLIError("Could not reconcile remote files" + (f": {detail}" if detail else "."))
    return result.stdout


def services():
    return sorted(p.parent.name for p in SERVICES.glob("*/compose.yml"))


def groups():
    found = {}
    if GROUPS.exists():
        for raw in GROUPS.read_text().splitlines():
            line = raw.partition("#")[0]
            if ":" in line:
                name, members = line.split(":", 1)
                if name.strip():
                    found[name.strip()] = members.split()
    return found


def targets(name):
    known = services()
    if name == "all":
        return ["infra"] + (["gateway"] if (ROOT / "gateway/compose.yml").exists() else []) + known
    if name == "services":
        if not known:
            raise CLIError("No services found under services/*/compose.yml")
        return known
    if name in ("infra", "gateway") or name in known:
        return [name]
    if name in groups():
        return groups()[name]
    raise CLIError(f"Unknown target or missing compose.yml: {name}")


def script(name, *args, env=None):
    run(sys.executable, ROOT / "scripts" / name, *args, env=env)


def domains_module():
    path = ROOT / "scripts/opendock-domains.py"
    spec = importlib.util.spec_from_file_location("opendock_domains", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def check_config(target, quiet=False):
    env = os.environ.copy()
    if quiet:
        env["CHECK_CONFIG_QUIET"] = "1"
    run(ROOT / "scripts/check-config.sh", target, env=env)


def compose(target, *args):
    directory = ROOT / target if target in ("infra", "gateway") else SERVICES / target
    if not (directory / "compose.yml").is_file():
        raise CLIError(f"Unknown target or missing compose.yml: {target}")
    if not (ROOT / "common.env").is_file():
        raise CLIError("Missing common.env. Run './opendock setup' or copy common.env.example first.")
    if target == "gateway" and args[0] in ("up", "start", "restart"):
        script("opendock-domains.py", "render")
    command = ["docker", "compose", "--project-directory", str(directory),
               "--env-file", str(ROOT / "common.env")]
    if (directory / ".env").is_file():
        command += ["--env-file", str(directory / ".env")]
    env = os.environ.copy()
    if target == "hermes":
        socket_path = Path(env.get("DOCKER_SOCKET", "/var/run/docker.sock"))
        if socket_path.exists():
            env["DOCKER_SOCKET_GID"] = str(socket_path.stat().st_gid)
        sandbox_path = ROOT / "services" / "hermes" / "data" / "sandboxes"
        sandbox_path.mkdir(parents=True, exist_ok=True)
        env["HERMES_SANDBOX_DIR"] = str(sandbox_path)
    run(*command, "-f", directory / "compose.yml", "-p", target, *args, env=env)


def lifecycle(command, target):
    for item in targets(target):
        if command in CHECKED:
            if command == "up":
                env = os.environ.copy()
                env["OPEN_DOCK_QUIET_SECRETS"] = "1"
                script("opendock-secrets.py", item, env=env)
            check_config(item, quiet=True)
        print(f"==> {item}: docker compose {command}", flush=True)
        compose(item, command, *(["-d"] if command == "up" else []))


def post_launch(target):
    selected = services() if target in ("all", "services") else (
        [] if target in ("infra", "gateway") else targets(target))
    for item in selected:
        hook = SERVICES / item / "opendock-post-launch.py"
        if hook.is_file():
            print(f"==> {item}: post-launch", flush=True)
            run(sys.executable, hook)


def reload_gateway():
    if not (ROOT / "gateway/compose.yml").is_file():
        return
    script("opendock-domains.py", "render")
    try:
        names = run("docker", "ps", "--format", "{{.Names}}", capture=True)
    except CLIError:
        names = ""
    if "caddy" in names.splitlines():
        print("==> gateway: caddy reload", flush=True)
        run("docker", "exec", "caddy", "caddy", "reload", "--config", "/etc/caddy/Caddyfile")
    else:
        print("==> gateway: docker compose up", flush=True)
        compose("gateway", "up", "-d")


def publish(target):
    run(ROOT / "scripts/publish-cloudflare.sh", target)


def launch(target):
    # Reuse the route resolver, including validation of host-owned domains.conf.
    domains = domains_module()
    routes = domains.resolve_routes()
    route = next((r for r in routes if r["hostname"] == target.lower().rstrip(".")), None)
    if route and route["type"] == "static":
        web_root = ROOT / "static-sites" / route["target"]
        web_root.mkdir(parents=True, exist_ok=True)
        print(f"Static site: {target}\nWeb root: {web_root}/\n"
              "Place the site's files there. Caddy and Cloudflare routing will now be applied.", flush=True)
        try:
            run("docker", "network", "inspect", "shared-net", quiet=True)
        except CLIError:
            print("==> network: create shared-net", flush=True)
            run("docker", "network", "create", "shared-net", quiet=True)
        lifecycle("up", "gateway")
        reload_gateway()
        publish(target)
        return
    if route:
        service = route["target"]
        lifecycle("up", "infra")
        lifecycle("up", service)
        post_launch(service)
        reload_gateway()
        publish(target)
        return
    if "." in target:
        raise CLIError(f"No route is configured for hostname: {target}\n"
                       f"Add one with: ./opendock route add {target} <service|static>")
    matches = [r["hostname"] for r in routes if r["type"] == "docker" and r["target"] == target]
    if len(matches) > 1:
        raise CLIError(f"'{target}' has multiple hostnames; use one of:\n" +
                       "\n".join(f"  ./opendock launch {host}" for host in matches))
    if target not in ("all", "infra"):
        print("==> infra: launch prerequisite", flush=True)
        lifecycle("up", "infra")
    lifecycle("up", target)
    post_launch(target)
    if target != "infra":
        reload_gateway()
    publish(target)


def route(command, hostname=None, service=None):
    if command == "show":
        script("opendock-domains.py", "list", *([hostname] if hostname else []))
    elif command == "add":
        script("opendock-domains.py", "add", hostname, service)
    else:
        # Keep the same ordering: remove Cloudflare entries before deleting local mapping.
        domains = domains_module()
        if not any(r["hostname"] == hostname.lower().rstrip(".") for r in domains.resolve_routes()):
            raise CLIError(f"No route is configured for hostname: {hostname}")
        script("publish-cloudflare.py", "remove", hostname)
        script("opendock-domains.py", "remove", hostname)
        script("opendock-domains.py", "render")
        try:
            names = run("docker", "ps", "--format", "{{.Names}}", capture=True)
        except CLIError:
            names = ""
        if "caddy" in names.splitlines():
            run("docker", "exec", "caddy", "caddy", "reload", "--config", "/etc/caddy/Caddyfile")
        else:
            print("Caddy is not running; updated route config will apply when it starts.")


def sync(name, dry_run=False):
    if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
        raise CLIError("Sync target must contain only letters, digits, '_' or '-'.")
    if tomllib is None:
        raise CLIError("Sync target config uses TOML and requires Python 3.11 or newer.")
    config = SYNC_CONFIG
    if not config.is_file():
        raise CLIError("Missing .sync.env.toml. Copy .sync.env.toml.example and configure a [targets.<name>] section.")
    try:
        with config.open("rb") as stream:
            settings = tomllib.load(stream)
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise CLIError(f"Could not read .sync.env.toml: {exc}") from exc
    targets = settings.get("targets", {})
    target = targets.get(name) if isinstance(targets, dict) else None
    if not isinstance(target, dict):
        available = ", ".join(sorted(targets)) if isinstance(targets, dict) and targets else "none"
        raise CLIError(f"Unknown sync target '{name}'. Available targets: {available}.")
    unknown = sorted(set(target) - {"remote", "path", "ssh_port"})
    if unknown:
        raise CLIError(f"Unknown key(s) under [targets.{name}]: {', '.join(unknown)}")
    remote = target.get("remote", "")
    path = target.get("path", "")
    port = target.get("ssh_port", 22)
    if not remote or not path:
        raise CLIError(f"Set both 'remote' and 'path' under [targets.{name}] in .sync.env.toml")
    if not isinstance(remote, str) or not isinstance(path, str):
        raise CLIError(f"'remote' and 'path' under [targets.{name}] must be strings")
    if not path.startswith("/") or ".." in Path(path).parts:
        raise CLIError(f"'path' under [targets.{name}] must be absolute and contain no '..' components")
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        raise CLIError(f"'ssh_port' under [targets.{name}] must be an integer from 1 to 65535")
    env = os.environ.copy()
    env["RSYNC_RSH"] = f"ssh -p {port}"
    print(f"Sync target: {name}\nSource: {ROOT}/\nDestination: {remote}:{path}/", flush=True)
    if dry_run:
        print("Mode: dry-run", flush=True)
    print("Scope: tracked and non-ignored untracked repository files.", flush=True)
    print("Source-only files are applied; destination-only files are pruned except protected runtime paths.", flush=True)
    try:
        listed = subprocess.run(
            ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
            cwd=ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise CLIError("Required command not found: git") from exc
    if listed.returncode:
        detail = listed.stderr.decode("utf-8", errors="replace").strip()
        raise CLIError(f"Could not list repository files for sync: {detail}")
    if not listed.stdout:
        raise CLIError("No Git-managed or non-ignored repository files found to sync.")

    file_list, remote_list = sync_file_list(listed.stdout)
    options = ["-azih", "--checksum", "--from0", "--files-from=-"]
    if dry_run:
        options.append("--dry-run")
    for value in EXCLUDES:
        options.append(f"--exclude={value}")
    options += ["--include=common.env.example", "--include=cloudflare.env.example",
                "--include=services/supabase/functions.env.example"]
    run("rsync", *options, f"{ROOT}/", f"{remote}:{path}/",
        env=env, input_data=file_list)
    prune_output = remote_sync_prune(
        remote, path, port, "preview" if dry_run else "apply", remote_list
    )
    sys.stdout.write(prune_output.decode("utf-8", errors="replace"))
    print("Done.")


def list_targets(kind=None):
    found = services()
    group_names = groups()
    if kind == "services":
        if not found:
            raise CLIError("No services found under services/*/compose.yml")
        print("\n".join(found))
    elif kind == "groups":
        if not GROUPS.is_file():
            print("No service groups found.")
        else:
            for name, members in group_names.items():
                print(f"{name}: {' '.join(members)}")
    else:
        print("Core:\n  infra")
        if (ROOT / "gateway/compose.yml").exists():
            print("  gateway")
        print("\nServices:")
        print("\n".join(f"  {name}" for name in found) if found else "  (none)")
        print("\nGroups:")
        print("\n".join(f"  {name}" for name in group_names) if group_names else "  (none)")


def parse_dotenv(path):
    values = {}
    if not path.is_file():
        return values
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip("\"'")
    return values


def configured_images(target):
    directory = ROOT / target if target in ("infra", "gateway") else SERVICES / target
    compose_file = directory / "compose.yml"
    if not compose_file.is_file():
        raise CLIError(f"Unknown target or missing compose.yml: {target}")
    values = parse_dotenv(ROOT / "common.env.example")
    values.update(parse_dotenv(ROOT / "common.env"))
    values.update(parse_dotenv(directory / ".env"))
    values.update(os.environ)
    result = []
    service_name = None
    for line in compose_file.read_text().splitlines():
        service_match = re.match(r"^  ([A-Za-z0-9_-]+):\s*(?:#.*)?$", line)
        if service_match:
            service_name = service_match.group(1)
        image_match = re.match(r"^\s+image:\s*['\"]?([^'\"\s#]+)", line)
        if not image_match:
            continue
        image = image_match.group(1)

        def substitute(match):
            variable, default = match.group(1), match.group(2)
            value = values.get(variable)
            if value is None or value == "":
                value = default or ""
            return value

        image = re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?::-([^}]*))?\}", substitute, image)
        image = re.sub(r"\$([A-Za-z_][A-Za-z0-9_]*)", lambda m: values.get(m.group(1), m.group(0)), image)
        result.append((service_name or "?", image))
    return result


def running_containers():
    try:
        output = run(
            "docker", "ps", "--all", "--format",
            "{{.Label \"com.docker.compose.project\"}}\t{{.Label \"com.docker.compose.service\"}}\t{{.Image}}\t{{.Status}}",
            capture=True,
        )
    except CLIError:
        return {}, "Docker is unavailable; showing configured image tags only."
    containers = {}
    for line in output.splitlines():
        project, service, image, status = (line.split("\t", 3) + [""] * 4)[:4]
        if project and service:
            containers.setdefault((project, service), []).append((image, status))
    return containers, None


def show_info(name=None):
    projects = ["infra"]
    if (ROOT / "gateway/compose.yml").is_file():
        projects.append("gateway")
    projects.extend(services())
    if name:
        projects = targets(name)
    containers, note = running_containers()
    print(f"{'TARGET':<18} {'SERVICE':<24} {'CONFIGURED IMAGE':<48} {'RUNNING'}")
    print("-" * 112)
    for project in projects:
        for service, image in configured_images(project):
            found = containers.get((project, service), [])
            if not found:
                state = "not running"
            else:
                state = "; ".join(f"{status} [{actual}]" for actual, status in found)
            print(f"{project:<18} {service:<24} {image:<48} {state}")
    if note:
        print(f"\n{note}")


