# renovate: datasource=docker depName=docmost/docmost
DOCMOST_VERSION=0.97.0
# renovate: datasource=docker depName=postgres
DOCMOST_POSTGRES_CLIENT_VERSION=18-alpine

DOCMOST_CONTAINER_NAME=docmost
DOCMOST_DB_HOST=postgres
DOCMOST_DB_PORT=5432
DOCMOST_DB_NAME=docmost
DOCMOST_DB_USER=docmost
DOCMOST_REDIS_URL=redis://redis:6379/1
DOCMOST_MAIL_FROM_NAME=Docmost
DOCMOST_DISABLE_TELEMETRY=true

# OpenDock managed settings. Local values are stored in the matching .env file.
DOCMOST_SUBDOMAIN=docmost
DOCMOST_DB_PASSWORD=change-docmost-db-password
DOCMOST_APP_SECRET=change-docmost-app-secret
