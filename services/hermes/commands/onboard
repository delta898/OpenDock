#!/bin/sh
set -eu

root="${OPENDOCK_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)}"
service_dir="$root/services/hermes"
sandbox_dir="$service_dir/data/sandboxes"
socket_path="${DOCKER_SOCKET:-/var/run/docker.sock}"

if ! "$root/opendock" check-config hermes; then
    echo "Hermes setup is incomplete. Run './opendock setup hermes', then retry onboarding." >&2
    exit 1
fi

mkdir -p "$sandbox_dir"
export HERMES_SANDBOX_DIR="$sandbox_dir"
export DOCKER_SOCKET_GID="$(python3 -c 'import os,sys; print(os.stat(sys.argv[1]).st_gid if os.path.exists(sys.argv[1]) else 0)' "$socket_path")"

exec docker compose \
    --project-directory "$service_dir" \
    --env-file "$root/common.env" \
    -f "$service_dir/compose.yml" \
    -p hermes \
    run --rm hermes setup
