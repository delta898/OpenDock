# renovate: datasource=docker depName=nextcloud
NEXTCLOUD_VERSION=33-apache

NEXTCLOUD_CONTAINER_NAME=nextcloud
NEXTCLOUD_DB_HOST=mariadb:3306
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_REDIS_HOST=redis
NEXTCLOUD_ADMIN_USER=admin

NEXTCLOUD_PHP_MEMORY_LIMIT=512M
NEXTCLOUD_PHP_UPLOAD_LIMIT=2G
NEXTCLOUD_APACHE_BODY_LIMIT=0

# OpenDock managed settings. Local values are stored in the matching .env file.
NEXTCLOUD_SUBDOMAIN=cloud
NEXTCLOUD_DB_PASSWORD=change-nextcloud-db-password
NEXTCLOUD_ADMIN_PASSWORD=change-nextcloud-admin-password
