MATTERMOST_VERSION=release-11
MATTERMOST_POSTGRES_CLIENT_VERSION=17-alpine

MATTERMOST_CONTAINER_NAME=mattermost
MATTERMOST_TIMEZONE=Asia/Seoul

MATTERMOST_DB_HOST=postgres
MATTERMOST_DB_PORT=5432
MATTERMOST_DB_NAME=mattermost
MATTERMOST_DB_USER=mattermost

MATTERMOST_ENABLE_SMTP_AUTH=true
MATTERMOST_SMTP_CONNECTION_SECURITY=STARTTLS
MATTERMOST_BOOTSTRAP_TIMEOUT=300
