# renovate: datasource=docker depName=wordpress
WORDPRESS_VERSION=7-php8.3-apache
WORDPRESS_CLI_IMAGE=wordpress:cli-php8.3

WORDPRESS_CONTAINER_NAME=wordpress
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_MULTISITE_TITLE=OpenDock WordPress Network

# OpenDock managed settings. Local values are stored in the matching .env file.
WORDPRESS_SUBDOMAIN=blog
WORDPRESS_DB_PASSWORD=change-wordpress-db-password
