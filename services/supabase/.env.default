SUPABASE_GOTRUE_VERSION=v2.189.0
# renovate: datasource=docker depName=postgrest/postgrest
SUPABASE_POSTGREST_VERSION=v14.12
# renovate: datasource=docker depName=supabase/realtime
SUPABASE_REALTIME_VERSION=v2.102.3
# renovate: datasource=docker depName=supabase/storage-api
SUPABASE_STORAGE_VERSION=v1.60.4
# renovate: datasource=docker depName=darthsim/imgproxy
SUPABASE_IMGPROXY_VERSION=v3.31.4
# renovate: datasource=docker depName=supabase/postgres-meta
SUPABASE_PG_META_VERSION=v0.96.6
# renovate: datasource=docker depName=supabase/studio
SUPABASE_STUDIO_VERSION=2026.08.03-sha-022b374
# renovate: datasource=docker depName=supabase/edge-runtime
SUPABASE_EDGE_RUNTIME_VERSION=v1.74.0
# renovate: datasource=docker depName=inbucket/inbucket
SUPABASE_INBUCKET_VERSION=3.2.0

SUPABASE_DB_CONTAINER_NAME=supabase-db
SUPABASE_DB_BOOTSTRAP_CONTAINER_NAME=supabase-db-bootstrap
SUPABASE_KONG_CONTAINER_NAME=supabase-kong
SUPABASE_AUTH_CONTAINER_NAME=supabase-auth
SUPABASE_REST_CONTAINER_NAME=supabase-rest
SUPABASE_REALTIME_CONTAINER_NAME=supabase-realtime
SUPABASE_STORAGE_CONTAINER_NAME=supabase-storage
SUPABASE_IMGPROXY_CONTAINER_NAME=supabase-imgproxy
SUPABASE_PG_META_CONTAINER_NAME=supabase-pg-meta
SUPABASE_STUDIO_CONTAINER_NAME=supabase-studio
SUPABASE_EDGE_RUNTIME_CONTAINER_NAME=supabase-edge-runtime
SUPABASE_INBUCKET_CONTAINER_NAME=supabase-inbucket

SUPABASE_DB_HOST=supabase-db
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_JWT_EXPIRY=3600
SUPABASE_REALTIME_DB_ENC_KEY=supabaserealtime
SUPABASE_EMAIL_AUTOCONFIRM=true

# OpenDock managed settings. Local values are stored in the matching .env file.
SUPABASE_SUBDOMAIN=supabase
SUPABASE_DB_PASSWORD=change-supabase-db-password
SUPABASE_JWT_SECRET=change-supabase-jwt-secret
SUPABASE_ANON_KEY=change-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=change-supabase-service-role-key
SUPABASE_PUBLISHABLE_KEY=change-supabase-publishable-key
SUPABASE_SECRET_KEY=change-supabase-secret-key
SUPABASE_ANON_KEY_ASYMMETRIC=change-supabase-anon-key-asymmetric
SUPABASE_SERVICE_ROLE_KEY_ASYMMETRIC=change-supabase-service-role-key-asymmetric
SUPABASE_JWT_KEYS=change-supabase-jwt-keys
SUPABASE_JWT_JWKS=change-supabase-jwt-jwks
SUPABASE_SECRET_KEY_BASE=change-supabase-secret-key-base
SUPABASE_PG_META_CRYPTO_KEY=change-supabase-pg-meta-crypto-key
SUPABASE_DASHBOARD_USER=opendock
SUPABASE_DASHBOARD_PASSWORD=change-supabase-dashboard-password
SUPABASE_STUDIO_DEFAULT_ORGANIZATION=OpenDock
SUPABASE_STUDIO_DEFAULT_PROJECT=OpenDock
