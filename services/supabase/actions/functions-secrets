#!/usr/bin/env python3
import os
import re
import shutil
from pathlib import Path


ROOT_DIR = Path(
    os.environ.get("OPENDOCK_ROOT", Path(__file__).resolve().parents[3])
).resolve()
SERVICE_DIR = ROOT_DIR / "services" / "supabase"
SECRETS_FILE = SERVICE_DIR / "functions.env"
EXAMPLE_FILE = SERVICE_DIR / "functions.env.example"
KEY_PATTERN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


def ensure_secrets_file():
    if SECRETS_FILE.exists():
        SECRETS_FILE.chmod(0o600)
        return False
    if not EXAMPLE_FILE.is_file():
        raise SystemExit("Missing services/supabase/functions.env.example")
    shutil.copyfile(EXAMPLE_FILE, SECRETS_FILE)
    SECRETS_FILE.chmod(0o600)
    return True


def configured_keys():
    keys = []
    invalid_lines = []
    for number, raw_line in enumerate(SECRETS_FILE.read_text().splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            invalid_lines.append(number)
            continue
        key = line.split("=", 1)[0].strip()
        if not KEY_PATTERN.fullmatch(key):
            invalid_lines.append(number)
            continue
        keys.append(key)
    return sorted(set(keys)), invalid_lines


def main():
    created = ensure_secrets_file()
    keys, invalid_lines = configured_keys()
    relative_path = SECRETS_FILE.relative_to(ROOT_DIR)

    print(f"Edge Function secrets: {relative_path}")
    print(f"Status: {'created from functions.env.example' if created else 'ready'}")
    print("Permissions: 0600")
    print()
    if keys:
        print("Configured names (values hidden):")
        for key in keys:
            print(f"  {key}")
    else:
        print("No user secrets are configured yet.")

    if invalid_lines:
        print()
        print("Invalid entries; expected KEY=value on lines:")
        for number in invalid_lines:
            print(f"  {number}")

    print()
    print("Edit the file on this host, for example:")
    print(f"  nano {relative_path}")
    print("Apply additions or changes by recreating the affected container:")
    print("  make up supabase")
    print()
    print("The values are available to all Edge Functions in this runtime.")
    print("The file is ignored by Git, excluded from sync, and not mounted in Studio.")
    return 1 if invalid_lines else 0


if __name__ == "__main__":
    raise SystemExit(main())
