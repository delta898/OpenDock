#!/usr/bin/env python3
import os
from pathlib import Path


ROOT_DIR = Path(
    os.environ.get("OPENDOCK_ROOT", Path(__file__).resolve().parents[3])
).resolve()
import sys
sys.path.insert(0, str(ROOT_DIR / "scripts"))
from opendock_settings import load_values


def parse_env(path):
    values = {}
    if not path.is_file():
        return values
    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip("'\"")
    return values


def main():
    values = load_values(service="supabase", process_env=False)
    publishable = values.get("SUPABASE_PUBLISHABLE_KEY", "")
    if not publishable.startswith("sb_publishable_"):
        print("Supabase publishable key has not been generated yet.")
        print("Run: ./opendock secrets supabase")
        return 1

    subdomain = values.get("SUPABASE_SUBDOMAIN", "supabase")
    domain = values.get("STACK_DOMAIN", "localhost")
    print("Supabase client configuration:")
    print(f"  URL: https://{subdomain}.{domain}")
    print(f"  Publishable key: {publishable}")
    print()
    print("Use SUPABASE_PUBLISHABLE_KEY in browsers, desktop/mobile apps, and CLIs.")
    print("SUPABASE_SECRET_KEY and legacy service-role/JWT values remain hidden in services/supabase/.env.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
