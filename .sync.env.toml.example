# Copy this file to .sync.env.toml and edit the destinations.
# Target names are used as: ./opendock sync <target>
# Review removals before applying: ./opendock sync <target> --dry-run

[targets.test]
remote = "user@test-host"
path = "/home/user/OpenDock"
# Optional; defaults to 22.
ssh_port = 22

# Add more destinations as separate target sections:
#
# [targets.production]
# remote = "user@production-host"
# path = "/home/user/OpenDock"
