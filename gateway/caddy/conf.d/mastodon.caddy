# Mastodon proxy behavior for domain mappings.
(mastodon_proxy) {
    import common_proxy
    import security_headers
    import block_bots

    @mastodon_streaming {
        path /api/v1/streaming*
    }
    reverse_proxy @mastodon_streaming mastodon-streaming:4000 {
        import forwarded_https
    }

    reverse_proxy mastodon-web:3000 {
        import forwarded_https
    }
}
